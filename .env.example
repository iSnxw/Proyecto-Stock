# URL de conexión de PostgreSQL (Neon) - rol de mínimo privilegio (app_stock_user)
DATABASE_URL=postgresql://app_stock_user:password@ep-ejemplo.us-east-2.aws.neon.tech/neondb?sslmode=require

# URL de administrador (solo local para seed_users.py, NO subir a Render)
DATABASE_ADMIN_URL=postgresql://neondb_owner:password@ep-ejemplo.us-east-2.aws.neon.tech/neondb?sslmode=require

# Clave secreta para sesiones de Flask (texto largo aleatorio)
SECRET_KEY=cambia-esta-clave-por-una-segura

# Entorno de Flask ('development' en local, 'production' en Render)
FLASK_ENV=development

# Configuración de tiempo máximo entre lecturas de frío (horas)
FRIO_INTERVALO_HORAS=12